{
  "name": "@codemode-examples/library",
  "private": true,
  "type": "module",
  "description": "LibraryService exposed through Code Mode: generated code, an in-memory server, and end-to-end tests.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node src/demo.ts",
    "mcp": "node src/mcp.ts",
    "test": "node --test test/*.test.ts",
    "test:bun": "bun test ./test",
    "test:deno": "deno test --no-check --allow-read --allow-env --allow-run test/"
  },
  "dependencies": {
    "@the-protobuf-project/codemode": "file:../../../runtime/runtime-ts/codemode",
    "@the-protobuf-project/errors": "file:../../../runtime/runtime-ts/errors",
    "@the-protobuf-project/network": "file:../../../runtime/runtime-ts/network",
    "@the-protobuf-project/protobuf": "file:../../../runtime/runtime-ts/protobuf",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
