{
  "name": "@the-protobuf-project/codemode",
  "version": "0.1.0",
  "description": "Runtime for Code Mode generated by protoc-gen-codemode: codecs, transports, sandboxes and the durable execution runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/the-protobuf-project/codemode.git", "directory": "packages/runtime" },
  "engines": { "node": ">=22.18" },
  "files": ["dist", "src"],
  "exports": {
    ".": { "source": "./src/index.ts", "bun": "./src/index.ts", "deno": "./src/index.ts", "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./quickjs": { "source": "./src/executor/quickjs.ts", "bun": "./src/executor/quickjs.ts", "deno": "./src/executor/quickjs.ts", "types": "./dist/executor/quickjs.d.ts", "default": "./dist/executor/quickjs.js" },
    "./deno": { "source": "./src/executor/deno.ts", "bun": "./src/executor/deno.ts", "deno": "./src/executor/deno.ts", "types": "./dist/executor/deno.d.ts", "default": "./dist/executor/deno.js" },
    "./sqlite": { "source": "./src/store/sqlite.ts", "bun": "./src/store/sqlite.ts", "deno": "./src/store/sqlite.ts", "types": "./dist/store/sqlite.d.ts", "default": "./dist/store/sqlite.js" },
    "./mcp": { "source": "./src/mcp/index.ts", "bun": "./src/mcp/index.ts", "deno": "./src/mcp/index.ts", "types": "./dist/mcp/index.d.ts", "default": "./dist/mcp/index.js" },
    "./ai": { "source": "./src/ai/index.ts", "bun": "./src/ai/index.ts", "deno": "./src/ai/index.ts", "types": "./dist/ai/index.d.ts", "default": "./dist/ai/index.js" },
    "./cloudflare": { "source": "./src/cloudflare/index.ts", "types": "./dist/cloudflare/index.d.ts", "default": "./dist/cloudflare/index.js" },
    "./browser": { "source": "./src/browser/index.ts", "types": "./dist/browser/index.d.ts", "default": "./dist/browser/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=source --test test/*.test.ts",
    "test:bun": "bun test ./test",
    "test:deno": "deno test --no-check --allow-read --allow-env --allow-run --conditions=source test/"
  },
  "dependencies": {
    "quickjs-emscripten": "^0.32.0",
    "sucrase": "^3.35.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": { "optional": true },
    "ai": { "optional": true }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "ai": "^7.0.179",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
