{
  "name": "@codemode-examples/library",
  "private": true,
  "type": "module",
  "description": "LibraryService exposed through Code Mode: generated code, an in-memory server, and end-to-end tests.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "bun src/demo.ts",
    "mcp": "bun src/mcp.ts",
    "test": "bun test ./test",
    "test:node": "node --test \"test/*.test.ts\"",
    "test:deno": "deno test --no-check --allow-read --allow-env --allow-run test/"
  },
  "dependencies": {
    "@the-protobuf-project/codemode": "^0.3.0",
    "@the-protobuf-project/errors": "^0.3.0",
    "@the-protobuf-project/network": "^0.3.0",
    "@the-protobuf-project/protobuf": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
